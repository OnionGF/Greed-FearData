# OpenD 默认本机网关；改端口时同步修改
FUTU_HOST=127.0.0.1
FUTU_PORT=11111

# US 或 HK
MARKET=US

# true = 强制演示数据（不连 OpenD）
DEMO_MODE=false

# 可选：对标站 ETF 列表签名密钥 + VIP 鉴权（勿提交真实值）
